{
 "pack": "paths",
 "description": "Sensitive-path probes (deep scans only, signature based)",
 "version": "1",
 "rules": [
  {
   "id": "PRB-0001",
   "type": "path_probe",
   "title": "Environment file (.env) is downloadable",
   "severity": "critical",
   "source": "S-OWASP-A05",
   "license": "Profitell original",
   "added": "2026-11-09",
   "status": "approved",
   "author": "Profitell Security Consulting",
   "path": "/.env",
   "expect_status": [
    200
   ],
   "finding_when": "found",
   "tags": [
    "exposure",
    "secrets"
   ],
   "body_regex": "(?m)^[A-Z][A-Z0-9_]{2,}=",
   "not_body_regex": "<html",
   "check": "APP-011"
  },
  {
