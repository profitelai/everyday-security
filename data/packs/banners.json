{
 "pack": "banners",
 "description": "Banner-version rules (end-of-life software)",
 "version": "1",
 "rules": [
  {
   "id": "VER-0001",
   "type": "banner_version",
   "title": "Apache HTTP Server older than 2.4 (end of life)",
   "severity": "high",
   "source": "https://httpd.apache.org/",
   "license": "Profitell original",
   "added": "2026-11-09",
   "status": "approved",
   "author": "Profitell Security Consulting",
   "header": "Server",
   "regex": "Apache/(\\d+\\.\\d+(?:\\.\\d+)?)",
   "bad_below": "2.4.0",
   "tags": [
    "end-of-life",
    "apache"
   ],
   "check": "HDR-009"
  },
  {
